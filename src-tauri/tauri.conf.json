{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade Tools",
  "version": "0.3.3",
  "identifier": "app.arcadetools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcade Tools",
        "width": 940,
        "height": 780,
        "minWidth": 640,
        "minHeight": 540,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://raw.githubusercontent.com; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "category": "Utility",
    "publisher": "qa-p1",
    "license": "MIT",
    "shortDescription": "Install and update the Arcade apps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../packaging/windows/tools-hooks.nsh",
        "template": "../packaging/windows/installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "resources/docs/": "docs/",
      "resources/catalog/": "catalog/"
    }
  }
}
