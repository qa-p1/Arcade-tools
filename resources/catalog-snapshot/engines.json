{
  "schema": 1,
  "engines": [
    {
      "id": "tesseract",
      "name": "Tesseract OCR",
      "homepage": "https://github.com/tesseract-ocr/tesseract",
      "detect": {
        "binaries": [
          "tesseract"
        ],
        "versionArgs": [
          "--version"
        ]
      },
      "usedBy": [
        {
          "app": "arcade.box",
          "for": "Recognize text in images and create searchable PDFs."
        },
        {
          "app": "arcade.lens",
          "for": "Recognize text in screen selections on Linux."
        }
      ],
      "install": {
        "arch": "sudo pacman -S tesseract",
        "debian": "sudo apt install tesseract-ocr",
        "fedora": "sudo dnf install tesseract",
        "macos": "brew install tesseract"
      },
      "linkDownload": true
    },
    {
      "id": "ripgrep",
      "name": "ripgrep",
      "homepage": "https://github.com/BurntSushi/ripgrep",
      "detect": {
        "binaries": [
          "rg"
        ],
        "versionArgs": [
          "--version"
        ]
      },
      "usedBy": [
        {
          "app": "arcade.find",
          "for": "Search inside file contents."
        }
      ],
      "install": {
        "arch": "sudo pacman -S ripgrep",
        "debian": "sudo apt install ripgrep",
        "fedora": "sudo dnf install ripgrep",
        "macos": "brew install ripgrep"
      },
      "linkDownload": false
    },
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "homepage": "https://ffmpeg.org/",
      "detect": {
        "binaries": [
          "ffmpeg",
          "ffprobe"
        ],
        "versionArgs": [
          "-version"
        ]
      },
      "usedBy": [
        {
          "app": "arcade.box",
          "for": "Inspect and convert audio and video, and record the screen."
        },
        {
          "app": "arcade.lens",
          "for": "Record screen selections on X11 and Windows."
        },
        {
          "app": "arcade.look",
          "for": "Optional example plugin to transcode unsupported video."
        }
      ],
      "install": {
        "arch": "sudo pacman -S ffmpeg",
        "debian": "sudo apt install ffmpeg",
        "fedora": "sudo dnf install ffmpeg-free",
        "macos": "brew install ffmpeg"
      },
      "linkDownload": false
    },
    {
      "id": "poppler",
      "name": "Poppler utilities",
      "homepage": "https://poppler.freedesktop.org/",
      "detect": {
        "binaries": [
          "pdftoppm",
          "pdftotext",
          "pdfinfo",
          "pdfimages",
          "pdfdetach"
        ],
        "versionArgs": [
          "-v"
        ]
      },
      "usedBy": [
        {
          "app": "arcade.box",
          "for": "Render PDFs, extract text and metadata, and list images and attachments."
        }
      ],
      "install": {
        "arch": "sudo pacman -S poppler",
        "debian": "sudo apt install poppler-utils",
        "fedora": "sudo dnf install poppler-utils",
        "macos": "brew install poppler"
      },
      "linkDownload": false
    },
    {
      "id": "qpdf",
      "name": "qpdf",
      "homepage": "https://github.com/qpdf/qpdf",
      "detect": {
        "binaries": [
          "qpdf"
        ],
        "versionArgs": [
          "--version"
        ]
      },
      "usedBy": [
        {
          "app": "arcade.box",
          "for": "Merge, split, sign, and make structural changes to PDFs."
        }
      ],
      "install": {
        "arch": "sudo pacman -S qpdf",
        "debian": "sudo apt install qpdf",
        "fedora": "sudo dnf install qpdf",
        "macos": "brew install qpdf"
