{
  "schema": 1,
  "app": "arcade.tools",
  "version": "0.3.6",
  "groups": [
    {
      "title": "Global",
      "context": "global",
      "shortcuts": [
        {
          "id": "cheat-sheet",
          "title": "Show shortcut cheat sheet",
          "keys": {
            "default": "Super+Slash",
            "windows": "Ctrl+Alt+Slash",
            "macos": "Ctrl+Alt+Slash"
          },
          "rebindable": false
        }
      ]
    },
    {
      "title": "Overlay",
      "context": "overlay",
      "shortcuts": [
        {
          "id": "close",
          "title": "Close the cheat sheet",
          "keys": {
