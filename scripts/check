#!/usr/bin/env bash
# Everything CI's check job runs before packaging, in the same order; ci.yml
# calls this script, so a green run here is a green CI step on this OS.
#   scripts/check            # needs npm ci done first
# On Linux the UI checks need Playwright's Chromium (npx playwright install
# chromium) and the Rust tests run in Link's disposable desktop session, from
# an Arcade-Link checkout at the pinned tag: ../Arcade-link, or $ARCADE_LINK.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s\n' "$*"; "$@"; }

step npm run typecheck
step npm run build
if [ "$(uname -s)" = Linux ]; then step npm run ui-checks; fi
step python3 scripts/ui-size.py
step python3 scripts/verify-vendored.py
step python3 scripts/check-versions.py
step python3 scripts/validate_shortcuts.py docs/user/shortcuts.json
step python3 scripts/test-docs-snapshot.py
step python3 scripts/docs-snapshot.py --check-links docs/user src-tauri/resources/docs
step cargo fmt --all --check
step cargo clippy --workspace --all-targets --locked -- -D warnings
if [ "$(uname -s)" = Linux ]; then
  link="${ARCADE_LINK:-../Arcade-link}"
  [ -f "$link/tools/e2e.py" ] || { echo "No Arcade-Link checkout at $link (set ARCADE_LINK)"; exit 1; }
  step env CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
    python3 "$link/tools/e2e.py" run -- cargo test --workspace --locked
else
  step cargo test --workspace --locked
fi
